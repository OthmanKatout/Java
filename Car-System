package application;

public class Car {

	String Name;
	static int Type , Colour; 
	boolean used , New ;
	double price;
	double Tax = 0.25;
	
	// ----------------------------
	
	Car (String name , int Type , int Color , boolean use , boolean New , double price , double tax){
	   this.Name = name ;
	   Car.Type = Type; 
	   Car.Colour = Color;
	   this.used = use ;
	   this.New = New;
	   this.price = price;
	   this.Tax = tax;
	}
	
	public double getPrice() {
		return (price + (price * Tax));
	}

	public String getName() {
		return Name;
	}

	public void setName(String name) {
		Name = name;
	}

	public static int getType() {
		return Type;
	}

	public static void setType(int type) {
		Type = type;
	}

	public static int getColour() {
		return Colour;
	}

	public static void setColour(int colour) {
		Colour = colour;
	}

	public boolean isUsed() {
		return used;
	}

	public void setUsed(boolean used) {
		this.used = used;
	}

	public void setPrice(double price) {
		this.price = price;
	}

	@Override
	public String toString() {
		return "Car [Name=" + Name + ", used=" + used + ", price=" + price + ", Tax=" + Tax + "]";
	}
	
	
	
	
}
// The Car Class
