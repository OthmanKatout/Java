package application;
	
import java.util.ArrayList;

import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.stage.Stage;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.ComboBox;
import javafx.scene.control.Label;
import javafx.scene.control.RadioButton;
import javafx.scene.control.TextField;
import javafx.scene.control.ToggleGroup;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.GridPane;
import javafx.scene.layout.HBox;
import javafx.scene.layout.VBox;


public class Main extends Application {
	
	public void start(Stage stage) {
		
		ArrayList<Car> list = new ArrayList<>();
		
		Label lapel = new Label("Customer Name");
		TextField txt1 = new TextField();
		Label lapel2 = new Label("Car Type");
		Label lapel3 = new Label("Colour");
		Label lapel4 = new Label("Status");
		Label lapel5 = new Label("Amount");
		Label lapel6 = new Label("Tax");
		TextField txt2 = new TextField();
		TextField txt3 = new TextField();
		
		ComboBox<String> comp = new ComboBox<>();
		comp.getItems().add("BMW");
		comp.getItems().add("Mazda");
		comp.getItems().add("Toyota");
		comp.setValue("BMW");
		comp.setPrefWidth(200);
		ComboBox<String> comp2 = new ComboBox<>();
		comp2.getItems().add("White");
		comp2.getItems().add("Red");
		comp2.getItems().add("Selver");
		comp2.setValue("White");
		comp2.setPrefWidth(200);
		RadioButton rd1 = new RadioButton("used");
		RadioButton rd2 = new RadioButton("new");
		ToggleGroup tog = new ToggleGroup();
		rd1.setToggleGroup(tog);
		rd2.setToggleGroup(tog);
		HBox h = new HBox(40);
		h.getChildren().addAll(rd1 , rd2);
		GridPane grid = new GridPane();
		grid.add(lapel, 0, 0);
		grid.add(txt1, 1, 0);
		grid.add(lapel2, 0, 1);
		grid.add(comp, 1, 1);
		grid.add(lapel3, 0, 2);
		grid.add(comp2, 1, 2);
		grid.add(lapel4, 0, 3);
		grid.add(h, 1, 3);
		grid.add(lapel5, 0, 4);
		grid.add(txt2, 1, 4);
		grid.add(lapel6 , 0 , 5);
		grid.add(txt3, 1, 5);
		grid.setHgap(60);
		grid.setVgap(5);
		VBox v = new VBox(5);
		HBox h2 = new HBox(7);
		Button b1 = new Button("Add");
		Button b2 = new Button("Clear");
		Button b3 = new Button("print List");
		
		b1.setPrefWidth(60);
		b2.setPrefWidth(60);
		b3.setPrefWidth(75);
		
		h2.getChildren().addAll(b1 , b2 , b3 );
		v.getChildren().addAll(grid , h2);
		
		v.setPadding(new Insets(10));
		v.setAlignment(Pos.TOP_CENTER);
		
		
		b1.setOnAction(e->{
			String name = txt1.getText();
			String type =comp.getValue();
			String color = comp2.getValue();
			String Amount = txt2.getText();
			String Tax = txt3.getText();
			boolean used = rd1.isSelected();
			boolean notused = rd2.isSelected();
			int num1 = 0  , num2 = 0;
			if(type.equals("BMW")){
				num1 = 1;
			}
			else if(type.equals("Mazda")) {
				num1 = 2;
			}
			else {
				num1 = 3;
			}
			if(color.equals("White")) {
				num2 = 1;
			}
			else if(color.equals("Red")) {
				num2 = 2;
			}
			else {
				num2 = 3;
			}
			int amount = Integer.parseInt(Amount);
			double tax = Double.parseDouble(Tax);
			Car car = new Car(name , num1 , num2 ,used , notused , amount , tax);
			list.add(car);
		});
	
		b2.setOnAction(e->{
			
			txt1.clear();
			comp.setValue("BMW");
			txt2.clear();
			txt3.clear();
			comp2.setValue("White");
			rd1.setSelected(false);
			rd2.setSelected(false);
		});
		
		b3.setOnAction(e->{
			for(int i = 0 ; i < list.size() ;i ++ ) {
				System.out.println(list.get(i).toString());
			}
		});	
		
		Scene sc = new Scene(v);
		
		stage.setScene(sc);
		stage.setTitle("Practical Final");
		stage.show();
	}
	public static void main(String[] args) {
		launch(args);
	}
}
